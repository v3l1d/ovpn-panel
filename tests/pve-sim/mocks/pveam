#!/bin/bash
echo "pveam $*" >> /var/log/pve-sim.log
case "$1" in
  update) echo "update successful" ;;
  available)
    printf 'system          debian-11-standard_11.7-1_amd64.tar.zst\n'
    printf 'system          debian-12-standard_12.2-1_amd64.tar.zst\n'
    printf 'system          debian-12-standard_12.7-1_amd64.tar.zst\n'
    printf 'system          ubuntu-24.04-standard_24.04-2_amd64.tar.zst\n' ;;
  list) printf 'NAME                                                         SIZE\n' ;;
  download) echo "download of $3 to $2 finished" ;;
  *) exit 2 ;;
esac
