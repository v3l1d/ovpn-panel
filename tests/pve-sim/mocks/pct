#!/bin/bash
# pct simulato: registra le chiamate; exec/push agiscono su questo stesso container.
echo "pct $*" >> /var/log/pve-sim.log
cmd="$1"; shift
case "$cmd" in
  create)
    id="$1"
    [[ $* == *"--unprivileged 1"* && $* == *"--rootfs "* && $* == *"--net0 "* ]] || { echo "pct create: argomenti attesi mancanti" >&2; exit 2; }
    echo "arch: amd64" > "/etc/pve/lxc/$id.conf" ;;
  start|stop|set|destroy|enter) ;;
  exec)
    shift  # id
    [[ $1 == -- ]] && shift
    exec "$@" ;;
  push)
    cp "$2" "$3" ;;
  *) echo "pct simulato: comando non gestito $cmd" >&2; exit 2 ;;
esac
